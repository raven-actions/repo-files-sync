# Normalize line endings to LF on checkout for every platform.
# This keeps source and test files byte-identical on Windows CI runners,
# so line-ending sensitive logic (git diff parsing, dedent template literals)
# behaves the same everywhere.
* text=auto eol=lf

# Explicitly treat lockfiles and shell scripts as LF text. The lockfile is also
# marked generated so GitHub collapses it in diffs and leaves it out of the
# repository's language statistics.
pnpm-lock.yaml text eol=lf linguist-generated=true
*.sh text eol=lf

# Windows batch scripts are only valid with CRLF, matching the .editorconfig
# rule for the same extensions.
*.cmd text eol=crlf
*.bat text eol=crlf
